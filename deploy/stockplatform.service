# systemd service: ให้ Streamlit รันเป็นบริการเบื้องหลัง เปิดเองตอนเครื่องบูต และเปิดใหม่เองถ้าล่ม
[Unit]
Description=Stock Platform (Streamlit)
After=network-online.target
Wants=network-online.target

[Service]
User=stockapp
Group=stockapp
WorkingDirectory=/opt/stock-platform
# รับแค่การเชื่อมต่อจากเครื่องตัวเอง (127.0.0.1) — คนนอกเข้าผ่าน nginx เท่านั้น
ExecStart=/opt/stock-platform/.venv/bin/streamlit run app.py \
  --server.address 127.0.0.1 --server.port 8501 --server.headless true \
  --server.runOnSave false --server.fileWatcherType none --browser.gatherUsageStats false
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
